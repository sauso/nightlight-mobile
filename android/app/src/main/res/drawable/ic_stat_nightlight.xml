<!-- Status-bar / notification small icon. Android renders the small icon as a solid silhouette
     from its alpha channel and tints it white, so this is a monochrome crescent-moon-and-star
     (echoing the app's launcher icon) rather than the full-colour launcher icon - which, being an
     opaque circle, was showing up as a plain white blob. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Crescent moon (a disc with a second disc carved out, leaving horns opening up-right). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.5,4 a9,9 0 1,0 8.5,9 c0,-0.3 -0.02,-0.6 -0.06,-0.9 a5.4,5.4 0 0,1 -4.3,2.1 a5.4,5.4 0 0,1 -3.1,-9.8 c-0.3,-0.04 -0.6,-0.06 -0.94,-0.06 Z" />
    <!-- Small four-point sparkle in the crescent's opening. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.7,3 L19.4,5.1 L21.5,5.8 L19.4,6.5 L18.7,8.6 L18,6.5 L15.9,5.8 L18,5.1 Z" />
</vector>
